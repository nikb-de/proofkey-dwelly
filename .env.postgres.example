# Local development only. Use a private copy outside version control.
# Generate each value separately with: openssl rand -hex 32
PROOFKEY_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
PROOFKEY_SERVICE_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_HEX
PROOFKEY_HTTP_PORT=8080
PROOFKEY_DATABASE_SCHEMA=public
PROOFKEY_DB_POOL_MAX=4
# Compose derives exact local Host authorities from PROOFKEY_HTTP_PORT.
# Direct serve deployments must set PROOFKEY_ALLOWED_HOSTS explicitly.
