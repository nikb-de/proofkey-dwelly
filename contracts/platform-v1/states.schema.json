{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:proofkey:platform:states:v1",
  "title": "ProofKey platform state axes v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["lifecycle", "evidence", "analysis", "decision", "action"],
  "properties": {
    "lifecycle": {"enum": ["new", "awaiting_information", "in_review", "awaiting_approval", "ready", "resolved", "escalated"]},
    "evidence": {"enum": ["empty", "text_available", "media_unprocessed", "mixed"]},
    "analysis": {"enum": ["not_started", "running", "current", "stale", "failed", "outcome_unknown"]},
    "decision": {"enum": ["none", "proposed", "blocked", "approved", "rejected", "superseded"]},
    "action": {"enum": ["none", "verified"]}
  }
}
