{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofkey.local/contracts/v1/asset.schema.json",
  "title": "asset",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "proofkey-asset-v1"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "source": {
      "$ref": "https://proofkey.local/contracts/v1/local-case.schema.json#/$defs/source"
    },
    "filename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "storage_scope": {
      "enum": [
        "browser_local",
        "target_private_blob"
      ]
    },
    "status": {
      "enum": [
        "validating",
        "ready",
        "rejected",
        "failed"
      ]
    },
    "media": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "asset_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "mime_type": {
              "enum": [
                "image/png",
                "image/jpeg"
              ]
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10485760
            }
          },
          "required": [
            "asset_id",
            "sha256",
            "mime_type",
            "size_bytes"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "asset_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "mime_type": {
              "enum": [
                "audio/mpeg",
                "audio/wav",
                "audio/mp4",
                "audio/webm"
              ]
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 26214400
            }
          },
          "required": [
            "asset_id",
            "sha256",
            "mime_type",
            "size_bytes"
          ],
          "additionalProperties": false
        }
      ]
    },
    "extraction_status": {
      "enum": [
        "not_started",
        "queued",
        "running",
        "completed",
        "failed",
        "unavailable"
      ]
    },
    "provenance": {
      "$ref": "https://proofkey.local/contracts/v1/local-case.schema.json#/$defs/provenance"
    }
  },
  "required": [
    "schema_version",
    "asset_id",
    "source",
    "filename",
    "storage_scope",
    "status",
    "media",
    "extraction_status",
    "provenance"
  ],
  "additionalProperties": false,
  "$defs": {},
  "description": "Metadata never proves persisted bytes, MIME validation, extraction or upload. Verify bytes and atomic persistence separately."
}
