{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision manifest row v0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "family_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,79}$"
    },
    "episode_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,79}$"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,79}$"
    },
    "origin": {
      "const": "original_synthetic"
    },
    "source_case_id": {
      "type": "null"
    },
    "split": {
      "enum": [
        "train",
        "development",
        "test"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "input_path": {
      "type": "string",
      "minLength": 1
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "label_path": {
      "type": "string",
      "minLength": 1
    },
    "label_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "simulator_path": {
      "type": "string",
      "minLength": 1
    },
    "annotation_status": {
      "const": "assistant_authored_draft"
    },
    "human_reviewed": {
      "const": false
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authoring_method": {
          "const": "assistant_authored_no_provider_api"
        },
        "generator_model": {
          "type": "null"
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1
        },
        "created_on": {
          "const": "2026-10-10"
        },
        "reference_status": {
          "const": "unvalidated_draft"
        }
      },
      "required": [
        "authoring_method",
        "generator_model",
        "prompt_version",
        "created_on",
        "reference_status"
      ]
    },
    "ambiguity": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "family_id",
    "episode_id",
    "decision_id",
    "origin",
    "source_case_id",
    "split",
    "tags",
    "input_path",
    "input_sha256",
    "label_path",
    "label_sha256",
    "simulator_path",
    "annotation_status",
    "human_reviewed",
    "provenance",
    "ambiguity",
    "exclusions"
  ]
}
