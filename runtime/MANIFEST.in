include pyproject.toml MANIFEST.in
include README.md DEMO.md LICENSE NOTICE RIGHTS.md DEPENDENCIES.json
include requirements.lock requirements-api.lock
recursive-include src/proofkey *.py
include src/proofkey/schema.sql
include src/proofkey/resources/profiles/flat-v1.json
include src/proofkey/resources/profiles/flat-v1.1.json
include src/proofkey/resources/profiles/flat-v1.2.json
include src/proofkey/resources/profiles/flat-v1.3.json
include src/proofkey/resources/profiles/flat-v1.4.json
include src/proofkey/resources/profiles/nested-v1.json
include src/proofkey/resources/profiles/nested-v1.1.json
include src/proofkey/resources/profiles/nested-v1.2.json
include src/proofkey/resources/profiles/nested-v1.3.json
include src/proofkey/resources/profiles/nested-v1.4.json
include src/proofkey/resources/fixtures/packet-world-v1.json
include src/proofkey/resources/fixtures/host-goods-world-v1.json
prune tests
prune .proofkey
prune .venv
prune venv
prune .pytest_cache
prune .superpowers
prune build
prune dist
prune outputs
prune ANSWERS
global-exclude __pycache__ *.py[cod] *.sqlite *.sqlite-* *.db *.db-*
