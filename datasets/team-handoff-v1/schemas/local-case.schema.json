{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofkey.local/contracts/v1/local-case.schema.json",
  "title": "local-case",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "links": {
      "type": "object",
      "properties": {
        "order_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "customer_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "operator_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        }
      },
      "required": [
        "order_id",
        "customer_id",
        "operator_id"
      ],
      "additionalProperties": false
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      },
      "uniqueItems": true,
      "maxItems": 16,
      "minItems": 2
    },
    "language": {
      "const": "en"
    },
    "schema_version": {
      "const": "dwelly-local-case-v1"
    },
    "source_mode": {
      "const": "local_fixture"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 128
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "https://proofkey.local/contracts/v1/local-case.schema.json#/$defs/event"
      },
      "maxItems": 128
    },
    "previous_snapshot_hash": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      ]
    },
    "snapshot_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtime_binding": {
      "type": "null"
    },
    "needs_analysis": {
      "const": true
    },
    "analysis_status": {
      "const": "pending_not_started"
    },
    "authorization": {
      "const": "unverified"
    },
    "operational_effects": {
      "const": 0
    }
