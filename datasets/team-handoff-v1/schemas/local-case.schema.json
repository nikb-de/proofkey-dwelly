        }
      },
      "required": [
        "case_id",
        "links",
        "participants",
        "language"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "occurred_at": {
          "type": "string",
          "maxLength": 64,
          "description": "Preserve the original string exactly. Structural validation intentionally accepts a superset of datetime.fromisoformat; CaseStore alone verifies date validity and a non-null timezone offset.",
          "minLength": 1
        },
        "channel": {
          "enum": [
            "chat",
            "email",
            "phone",
            "internal"
          ]
        },
        "sender_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "recipient_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "uniqueItems": true,
          "maxItems": 16
        },
        "kind": {
          "enum": [
            "message",
            "photo",
            "voice_message",
            "call_recording"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "media": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "asset_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "mime_type": {
                  "enum": [
                    "image/png",
                    "image/jpeg"
                  ]
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10485760
                }
              },
              "required": [
                "asset_id",
                "sha256",
                "mime_type",
                "size_bytes"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "asset_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "mime_type": {
                  "enum": [
                    "audio/mpeg",
                    "audio/wav",
                    "audio/mp4",
                    "audio/webm"
                  ]
                },
                "size_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 26214400
                }
              },
              "required": [
                "asset_id",
                "sha256",
                "mime_type",
                "size_bytes"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "event_id",
        "occurred_at",
        "channel",
        "sender_id",
        "recipient_ids",
        "kind",
        "text",
        "media"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "message"
              }
            }
          },
          "then": {
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "media": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "photo"
              }
            }
          },
          "then": {
            "properties": {
              "media": {
                "type": "object",
                "properties": {
                  "asset_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "mime_type": {
                    "enum": [
                      "image/png",
                      "image/jpeg"
                    ]
                  },
                  "size_bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10485760
                  }
                },
                "required": [
                  "asset_id",
                  "sha256",
                  "mime_type",
                  "size_bytes"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "voice_message",
                  "call_recording"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "media": {
                "type": "object",
                "properties": {
                  "asset_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "mime_type": {
                    "enum": [
                      "audio/mpeg",
                      "audio/wav",
                      "audio/mp4",
                      "audio/webm"
                    ]
                  },
                  "size_bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 26214400
                  }
                },
                "required": [
                  "asset_id",
                  "sha256",
                  "mime_type",
                  "size_bytes"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      ]
    },
    "append": {
      "type": "object",
      "properties": {
        "expected_revision": {
          "type": "integer",
