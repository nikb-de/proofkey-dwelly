    "case_id",
    "links",
    "participants",
    "language",
    "schema_version",
    "source_mode",
    "revision",
    "events",
    "previous_snapshot_hash",
    "snapshot_hash",
    "runtime_binding",
    "needs_analysis",
    "analysis_status",
    "authorization",
    "operational_effects"
  ],
  "additionalProperties": false,
  "description": "Structural snapshot. Hash, revision/event count, linked identities and immutable history require actual CaseStore semantic checks.",
  "allOf": [
    {
      "if": {
        "properties": {
          "revision": {
            "const": 0
          }
        }
      },
      "then": {
        "properties": {
          "events": {
            "maxItems": 0
          },
          "previous_snapshot_hash": {
            "type": "null"
          }
