{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofkey.local/contracts/v1/decision-label.schema.json",
  "title": "decision-label",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "proofkey-decision-label-v1"
    },
    "visibility": {
      "const": "evaluator_only"
    },
    "label_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "input_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "source": {
      "$ref": "https://proofkey.local/contracts/v1/local-case.schema.json#/$defs/source"
    },
    "expected_disposition": {
      "enum": [
        "request_information",
        "hold",
        "propose_reschedule",
        "escalate",
        "no_action"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "review": {
      "$ref": "https://proofkey.local/contracts/v1/local-case.schema.json#/$defs/review"
    },
    "provenance": {
      "$ref": "https://proofkey.local/contracts/v1/local-case.schema.json#/$defs/provenance"
    }
  },
  "required": [
    "schema_version",
    "visibility",
    "label_id",
    "input_id",
    "source",
    "expected_disposition",
    "rationale",
    "review",
    "provenance"
  ],
  "additionalProperties": false
}
