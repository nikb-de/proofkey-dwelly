{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofkey.local/contracts/v1/decision-input.schema.json",
  "title": "decision-input",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "proofkey-decision-input-v1"
    },
    "visibility": {
      "const": "model_visible"
    },
    "input_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "source": {
      "$ref": "https://proofkey.local/contracts/v1/local-case.schema.json#/$defs/source"
    },
    "snapshot": {
      "$ref": "https://proofkey.local/contracts/v1/local-case.schema.json"
    },
    "provenance": {
      "$ref": "https://proofkey.local/contracts/v1/local-case.schema.json#/$defs/provenance"
    }
  },
  "required": [
    "schema_version",
    "visibility",
    "input_id",
    "source",
    "snapshot",
    "provenance"
  ],
  "additionalProperties": false
}
