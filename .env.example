# Local configuration only. Copy to .env; keep .env private and out of Git.
# The current CLIs do NOT automatically load dotenv files.
# Analysis-only opt-in loader: --provider-env-file .env reads four provider
# names as data (no shell execution). See docs/model-analysis-operations.md.
# From the repository root: set -a; source ./.env; set +a
# Never source an untrusted file. Blank credentials are not valid credentials.
# Fill or remove blank assignments before loading; they replace existing values.

# Read by tools.dwelly_service. Set a private token of at least 16 characters.
# Generate locally, for example with: openssl rand -hex 32
PROOFKEY_SERVICE_TOKEN=

# Read by tools.dwelly_model only for explicitly enabled live calls.
# This file does not enable live mode or authorize a new paid experiment.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional in the provider, but required by the current example configuration.
ANTHROPIC_WORKSPACE_ID=

# Reserved deployment inputs: not read by the local service and no deployment
# is triggered by setting them. Confirm project, region and identity first.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=
PROOFKEY_CLOUD_SERVICE=
PROOFKEY_CLOUD_SERVICE_ACCOUNT=
